# Copy to .env.production on the deployment host. This template contains no usable secrets.
# Keep this project name stable: changing it selects different volumes/containers.
COMPOSE_PROJECT_NAME=bookguard-prod
BOOKGUARD_DOMAIN=bookguard.yourdomain.vn
ACME_EMAIL=admin@yourdomain.vn

# Public production provisions Secure only, with no demo seed/reset.
SQLSERVER_SA_PASSWORD=
MSSQL_PID=Express
SECURE_DB_NAME=BookGuardSecure
SECURE_DB_USER=bookguard_secure
SECURE_DB_PASSWORD=
# Generate two independent values, e.g. openssl rand -hex 32.
SECURE_JWT_SECRET=
CSRF_SECRET=

# Explicit one-time admin task. Remove password after successful creation.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Direct TLS SMTP only (typically 465); STARTTLS/587 is not implemented.
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=notifications@yourdomain.vn
MAIL_FROM_NAME="Thư An Bookstore"

# Optional alerts: leave both Telegram fields blank if disabled.
ALERT_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_THROTTLE_SECONDS=300
ALERT_MAX_ATTEMPTS=2
ALERT_RETRY_DELAY_MS=250
ALERT_TIMEOUT_MS=8000

# Durable uploads are included alongside SQL; each job restores a unique SQL probe.
# Backup root must be within this checkout; retain restrictive permissions.
BACKUP_ROOT=backups/production
BACKUP_RETENTION_DAYS=7
# Explicit opt-in for backup failure alerts to configured recipients.
BACKUP_SEND_ALERTS=false
# Choose S3 OR paired command argument arrays; no shell command strings.
# BACKUP_OFFSITE_S3_BUCKET=your-bucket
# BACKUP_OFFSITE_S3_ENDPOINT=https://your-s3-compatible-endpoint.example
# Supply AWS credentials through the scheduler environment/credential provider.
# BACKUP_OFFSITE_UPLOAD_ARGS=["rclone","copy","%DIR%","remote:bookguard/%STAMP%"]
# BACKUP_OFFSITE_DOWNLOAD_ARGS=["rclone","copy","remote:bookguard/%STAMP%","%DIR%"]

# VNPay remains disabled until your own merchant credentials are configured.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_ENABLED=false
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_QUERY_TIMEOUT_MS=8000
VNPAY_QUERY_IP_ADDRESS=

STOCK_HOLD_ENABLED=true
STOCK_HOLD_MINUTES=30
STOCK_HOLD_GRACE_MINUTES=5
STOCK_HOLD_INTERVAL_SECONDS=60
STOCK_HOLD_BATCH_SIZE=25
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_TTL_DAYS=7
