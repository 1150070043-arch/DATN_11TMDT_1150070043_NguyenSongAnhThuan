{
  "name": "bookguard-datn",
  "version": "1.6.0",
  "private": true,
  "description": "Website bán sách và môi trường thực nghiệm bảo mật nhiều lớp cho đồ án tốt nghiệp",
  "workspaces": [
    "apps/api",
    "apps/web",
    "tests/functional",
    "tests/security",
    "tests/e2e"
  ],
  "scripts": {
    "up:secure": "docker compose up -d --build web-secure",
    "up:baseline": "docker compose up -d --build web-baseline",
    "stop:secure": "docker compose stop web-secure api-secure mailpit",
    "stop:baseline": "docker compose stop web-baseline api-baseline mailpit-baseline",
    "db:init:secure": "npm run db:init --workspace @bookguard/api -- secure",
    "db:init:baseline": "npm run db:init --workspace @bookguard/api -- baseline",
    "test:isolation": "npm run build --workspace @bookguard/api && node --test apps/api/dist/config.test.js && npm run test --workspace @bookguard/e2e-tests -- twin-isolation",
    "test:isolation:storage": "node scripts/check-twin-storage.mjs",
    "dev:api:baseline": "npm run dev:baseline --workspace @bookguard/api",
    "dev:api:secure": "npm run dev:secure --workspace @bookguard/api",
    "dev:web:baseline": "npm run dev:baseline --workspace @bookguard/web",
    "dev:web:secure": "npm run dev:secure --workspace @bookguard/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @bookguard/api",
    "verify": "npm run typecheck && npm test && npm run build",
    "test:functional": "npm run test --workspace @bookguard/functional-tests",
    "test:commerce": "npm run test:commerce --workspace @bookguard/functional-tests",
    "test:auth-maintenance": "npm run test:auth-maintenance --workspace @bookguard/functional-tests",
    "test:security-hardening": "npm run test:security-hardening --workspace @bookguard/functional-tests",
    "auth:cleanup": "npm run auth:cleanup --workspace @bookguard/api --",
    "db:backup": "node --env-file=.env scripts/db-backup.mjs",
    "db:backup:offsite": "node --env-file=.env scripts/db-backup-offsite.mjs",
    "test:smtp": "node --env-file=.env scripts/test-smtp.mjs",
    "test:security": "npm run test --workspace @bookguard/security-tests",
    "test:e2e": "npm run test --workspace @bookguard/e2e-tests",
    "test:e2e:ui": "npm run test:ui --workspace @bookguard/e2e-tests",
    "test:ux": "npm run test --workspace @bookguard/e2e-tests -- --config ux.config.ts",
    "test:ux:mobile": "npm run test --workspace @bookguard/e2e-tests -- --config mobile-ux.config.ts",
    "test:ux:mobile:commerce": "npm run test --workspace @bookguard/e2e-tests -- --config mobile-commerce.config.ts",
    "test:security:browser": "npm run test:security:browser --workspace @bookguard/e2e-tests",
    "db:init": "npm run db:init --workspace @bookguard/api",
    "db:reset": "npm run db:reset --workspace @bookguard/api",
    "test:payments": "npm run test:payments --workspace @bookguard/functional-tests",
    "test:payments:ux": "npm run test --workspace @bookguard/e2e-tests -- --config payments-ux.config.ts",
    "test:stock-holds": "npm run test:stock-holds --workspace @bookguard/functional-tests",
    "test:operations": "node --test scripts/operations.test.mjs",
    "db:backup:production": "node --env-file=.env.production scripts/db-backup.mjs --production",
    "db:backup:offsite:production": "node --env-file=.env.production scripts/db-backup-offsite.mjs --production",
    "db:restore:drill": "node --env-file=.env scripts/db-restore-drill.mjs",
    "db:restore:drill:production": "node --env-file=.env.production scripts/db-restore-drill.mjs --production",
    "ops:check:production": "node --env-file=.env.production scripts/check-production.mjs",
    "ops:status": "node --env-file=.env scripts/ops-status.mjs",
    "ops:status:production": "node --env-file=.env.production scripts/ops-status.mjs --production",
    "test:operations:production": "node scripts/verify-production-drill.mjs",
    "ci:sql": "node scripts/ci-sql.mjs",
    "test:ci": "node --test scripts/ci.test.mjs",
    "ci:evidence": "node scripts/ci-evidence.mjs",
    "test:ui:layout": "npm run test --workspace @bookguard/e2e-tests -- --config ui-layout.config.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
