NODE_ENV=development
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_SA_USER=sa
SQLSERVER_SA_PASSWORD=ChangeThis_SA_Password_123!
BASELINE_DB_NAME=BookGuardBaseline
BASELINE_DB_USER=bookguard_baseline
BASELINE_DB_PASSWORD=ChangeThis_Baseline_123!
SECURE_DB_NAME=BookGuardSecure
SECURE_DB_USER=bookguard_secure
SECURE_DB_PASSWORD=ChangeThis_Secure_123!
BASELINE_JWT_SECRET=baseline-lab-secret
SECURE_JWT_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-a-different-32-character-random-secret
BASELINE_WEB_ORIGIN=http://localhost:5173
SECURE_WEB_ORIGIN=http://localhost:5174
# Local dev: separate directories, relative to apps/api. Docker uses its own volumes.
BASELINE_UPLOAD_DIR=../../uploads/baseline
SECURE_UPLOAD_DIR=../../uploads/secure
REPORTS_DIR=../../reports/generated
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Baseline local dev always uses its isolated Mailpit on localhost:1026 (UI :8026).
MAIL_FROM_ADDRESS=no-reply@bookguard.local
MAIL_FROM_NAME=Thư An Bookstore
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_TTL_DAYS=7
TRUST_PROXY_HOPS=0
