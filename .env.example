NODE_ENV=development
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_ENCRYPT=true
# Trust the self-signed certificate only for the local SQL container.
# Remote SQL: set false and install/use a trusted server certificate.
SQLSERVER_TRUST_CERTIFICATE=true
SQLSERVER_SA_USER=sa
SQLSERVER_SA_PASSWORD=ChangeThis_SA_Password_123!
BASELINE_DB_NAME=BookGuardBaseline
BASELINE_DB_USER=bookguard_baseline
BASELINE_DB_PASSWORD=ChangeThis_Baseline_123!
SECURE_DB_NAME=BookGuardSecure
SECURE_DB_USER=bookguard_secure
SECURE_DB_PASSWORD=ChangeThis_Secure_123!
BASELINE_JWT_SECRET=baseline-lab-secret
SECURE_JWT_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-a-different-32-character-random-secret
BASELINE_WEB_ORIGIN=http://localhost:5173
SECURE_WEB_ORIGIN=http://localhost:5174
# Local dev: separate directories, relative to apps/api. Docker uses its own volumes.
BASELINE_UPLOAD_DIR=../../uploads/baseline
SECURE_UPLOAD_DIR=../../uploads/secure
REPORTS_DIR=../../reports/generated
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Docker routes mail to its isolated Mailpit unless explicitly overridden.
DOCKER_SMTP_HOST=mailpit
DOCKER_SMTP_PORT=1025
DOCKER_SMTP_SECURE=false
DOCKER_SMTP_USER=
DOCKER_SMTP_PASSWORD=
# Baseline local dev always uses its isolated Mailpit on localhost:1026 (UI :8026).
MAIL_FROM_ADDRESS=no-reply@bookguard.local
MAIL_FROM_NAME=Thư An Bookstore
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_TTL_DAYS=7
AUTH_CLEANUP_ENABLED=true
AUTH_CLEANUP_INTERVAL_MINUTES=60
AUTH_CLEANUP_RETENTION_DAYS=7
AUTH_CLEANUP_BATCH_SIZE=500
AUTH_CLEANUP_MAX_BATCHES=10

# New VNPay orders: fixed payment window + callback grace, legacy orders are not backfilled.
STOCK_HOLD_ENABLED=true
STOCK_HOLD_MINUTES=30
STOCK_HOLD_GRACE_MINUTES=5
STOCK_HOLD_INTERVAL_SECONDS=60
STOCK_HOLD_BATCH_SIZE=25
TRUST_PROXY_HOPS=0
# Optional VNPay sandbox credentials supplied for your own merchant account.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Enable only after configuring your own merchant query endpoint.
VNPAY_QUERY_ENABLED=false
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_QUERY_TIMEOUT_MS=8000
# Optional public egress IP used by VNPay querydr, without quotes.
# VNPAY_QUERY_IP_ADDRESS=203.0.113.10
# When configured, use the externally reachable API return endpoint.
# VNPAY_RETURN_URL=https://api.example.com/api/payments/vnpay-return
